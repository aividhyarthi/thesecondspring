---
export const prerender = false;
const title = 'Human Content Studio';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="theme-color" content="#f6f4ef" />
  <title>{title} | Private workspace</title>
  <style>
    :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#20251f;background:#f6f4ef;font-synthesis:none}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;background:#f6f4ef}
    button,input,select,textarea{font:inherit}button{cursor:pointer}
    .shell{max-width:1160px;margin:0 auto;padding:28px 22px 70px}
    .top{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:34px}
    .brand{display:flex;align-items:center;gap:12px}.mark{width:38px;height:38px;border-radius:12px;background:#244a3b;color:white;display:grid;place-items:center;font-family:Georgia,serif;font-size:23px}
    .brand strong{display:block;font-size:15px;letter-spacing:-.2px}.brand span{display:block;color:#778078;font-size:12px;margin-top:3px}
    .private{font-size:12px;color:#63736a;border:1px solid #dce2d9;border-radius:30px;padding:8px 12px;background:#fff}
    h1{font-family:Georgia,serif;font-size:clamp(34px,5vw,49px);font-weight:500;letter-spacing:-1.7px;margin:0 0 10px}
    .intro{color:#667169;line-height:1.65;max-width:700px;margin:0 0 27px}
    .tabs{display:flex;gap:8px;margin-bottom:18px}.tab{border:1px solid #d9dfd7;background:#fff;color:#526057;border-radius:9px;padding:11px 16px;font-weight:600}.tab.active{background:#244a3b;color:#fff;border-color:#244a3b}
    .panel{background:#fff;border:1px solid #e4e7e0;border-radius:16px;padding:22px;box-shadow:0 8px 30px rgba(35,49,39,.035)}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field{display:flex;flex-direction:column;gap:7px;margin-bottom:15px}.field label{font-size:12px;font-weight:700;color:#4b584f;letter-spacing:.2px}
    input,select,textarea{width:100%;border:1px solid #dfe4dc;border-radius:9px;padding:12px 13px;color:#20251f;background:#fff;outline:none}
    input:focus,select:focus,textarea:focus{border-color:#71917e;box-shadow:0 0 0 3px rgba(113,145,126,.13)}
    textarea{min-height:150px;resize:vertical;line-height:1.55}.draft{min-height:270px}
    .hint{font-size:12px;color:#879087;line-height:1.5;margin-top:-4px}
    .checks{display:flex;align-items:center;gap:9px;margin:4px 0 18px;font-size:13px;color:#58645b}.checks input{width:16px;height:16px;accent-color:#244a3b}
    .primary{border:0;border-radius:9px;padding:13px 19px;background:#244a3b;color:white;font-weight:700}.primary:disabled{opacity:.55;cursor:wait}
    .secondary{border:1px solid #dce2d9;border-radius:9px;padding:10px 13px;background:#fff;color:#405047;font-weight:600}
    .status{font-size:13px;color:#6c776e;margin-left:10px}.error{color:#a43d32;background:#fff4f1;border:1px solid #f0d5ce;padding:12px;border-radius:9px;margin:12px 0}
    .result{margin-top:25px;display:none}.result-head{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:15px}
    .result-head h2{font-family:Georgia,serif;font-weight:500;font-size:27px;margin:0}.score{display:inline-flex;align-items:center;gap:8px;border-radius:30px;background:#edf4ee;color:#28523b;padding:8px 12px;font-size:13px;font-weight:700}
    .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:15px}.metric{background:#f7f8f5;border:1px solid #e8ebe5;border-radius:10px;padding:13px}.metric b{display:block;font-size:22px;font-family:Georgia,serif;font-weight:500}.metric span{font-size:11px;color:#748076}
    .report{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:15px 0}.report-card{border:1px solid #e7eae4;border-radius:11px;padding:15px}.report-card h3{font-size:13px;margin:0 0 9px}.report-card ul{margin:0;padding-left:18px;color:#657067;font-size:13px;line-height:1.6}
    .article{white-space:pre-wrap;line-height:1.72;font-size:14px;max-height:900px;overflow:auto;background:#fbfcfa;border:1px solid #e6eae3;border-radius:11px;padding:20px}
    .meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:15px 0}.source-list{font-size:12px;line-height:1.7;color:#68746b;padding-left:20px}
    .source-list a{color:#315e48;overflow-wrap:anywhere}
    .login-wrap{max-width:420px;margin:10vh auto}.login-wrap .panel{padding:28px}.login-wrap h1{font-size:34px}
    .hidden{display:none!important}.foot{font-size:11px;color:#8b948b;text-align:center;margin-top:28px}
    @media(max-width:720px){.shell{padding:18px 14px 50px}.grid,.report,.meta-grid{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.panel{padding:16px}.private{display:none}.top{margin-bottom:25px}}
  </style>
</head>
<body>
  <main class="shell">
    <header class="top">
      <div class="brand"><div class="mark">S</div><div><strong>Human Content Studio</strong><span>Private editorial workspace</span></div></div>
      <div class="private">Private access · Not indexed</div>
      <button id="logout" class="secondary hidden">Sign out</button>
    </header>

    <section id="login" class="login-wrap hidden">
      <div class="panel">
        <h1>Welcome back.</h1>
        <p class="intro">Sign in to your private content workspace.</p>
        <form id="loginForm">
          <div class="field"><label for="password">STUDIO PASSWORD</label><input id="password" type="password" autocomplete="current-password" required /></div>
          <button class="primary" type="submit">Open studio</button><div id="loginError" class="error hidden"></div>
        </form>
      </div>
    </section>

    <section id="workspace" class="hidden">
      <h1>Make every article worth reading.</h1>
      <p class="intro">Research, create or improve an existing draft. The studio checks the evidence, strengthens the editorial voice and prepares the article for your review.</p>
      <div class="tabs">
        <button class="tab active" data-mode="create">Create new content</button>
        <button class="tab" data-mode="humanise">Improve existing draft</button>
      </div>
      <form id="studioForm" class="panel">
        <div class="grid">
          <div class="field"><label for="brand">WEBSITE / EDITORIAL PROFILE</label>
            <select id="brand"><option value="second-spring">The Second Spring</option><option value="rudra-kasturi">Rudra Kasturi</option><option value="southwala">Southwala</option><option value="general">General editorial</option></select>
          </div>
          <div class="field"><label for="wordCount">APPROXIMATE ARTICLE LENGTH</label>
            <select id="wordCount"><option value="1000">1,000 words</option><option value="1500" selected>1,500 words</option><option value="1800">1,800 words</option><option value="2200">2,200 words</option><option value="2800">2,800 words</option></select>
          </div>
        </div>
        <div id="topicField" class="field"><label for="topic">TOPIC OR WORKING TITLE</label><input id="topic" placeholder="Example: How perimenopause affects sleep in Indian women" /></div>
        <div id="draftField" class="field hidden"><label for="draft">PASTE YOUR EXISTING ARTICLE</label><textarea id="draft" class="draft" placeholder="Paste the complete draft you want the studio to improve..."></textarea><div class="hint">The studio will preserve the meaning and important details while improving the editorial construction.</div></div>
        <div class="grid">
          <div class="field"><label for="primaryKeyword">PRIMARY KEYWORD</label><input id="primaryKeyword" placeholder="Optional" /></div>
          <div class="field"><label for="secondaryKeywords">SECONDARY KEYWORDS</label><input id="secondaryKeywords" placeholder="Separate with commas" /></div>
        </div>
        <div class="field"><label for="audience">TARGET AUDIENCE (OPTIONAL)</label><input id="audience" placeholder="Who should this article help?" /></div>
        <div class="field"><label for="brief">ADDITIONAL INSTRUCTIONS</label><textarea id="brief" style="min-height:90px" placeholder="Any angle, questions to answer, sources to include, or details to preserve..."></textarea></div>
        <label class="checks"><input id="research" type="checkbox" checked /> Research current information and include source references</label>
        <button id="generate" class="primary" type="submit">Research and create article</button><span id="status" class="status"></span><div id="formError" class="error hidden"></div>
      </form>

      <section id="result" class="result">
        <div class="result-head"><h2 id="resultTitle">Your article</h2><div class="score" id="score">Editorial score</div></div>
        <div class="metrics">
          <div class="metric"><b id="accuracy">—</b><span>Accuracy and evidence</span></div>
          <div class="metric"><b id="usefulness">—</b><span>Reader usefulness</span></div>
          <div class="metric"><b id="originality">—</b><span>Originality and depth</span></div>
          <div class="metric"><b id="voice">—</b><span>Voice and readability</span></div>
        </div>
        <div class="report">
          <div class="report-card"><h3>What is working</h3><ul id="strengths"></ul></div>
          <div class="report-card"><h3>What needs your attention</h3><ul id="issues"></ul></div>
        </div>
        <div class="meta-grid">
          <div class="field"><label>SEO TITLE</label><input id="seoTitle" readonly /></div>
          <div class="field"><label>META DESCRIPTION</label><input id="metaDescription" readonly /></div>
          <div class="field"><label>SUGGESTED URL SLUG</label><input id="slug" readonly /></div>
          <div class="field"><label>PRIMARY KEYWORD</label><input id="resultKeyword" readonly /></div>
        </div>
        <div class="result-head"><h2>Article preview</h2><div><button id="copy" class="secondary">Copy article</button> <button id="download" class="secondary">Download Markdown</button></div></div>
        <div id="article" class="article"></div>
        <div class="report-card" style="margin-top:15px"><h3>Sources and references</h3><ul id="sources" class="source-list"></ul></div>
        <p id="reviewNote" class="hint"></p>
      </section>
    </section>
    <div class="foot">Private editorial workspace. Articles remain drafts until you review and approve them.</div>
  </main>
<script>
(() => {
  const $ = (id) => document.getElementById(id);
  let mode = 'create';
  let latest = null;
  const login = $('login'), workspace = $('workspace');
  const show = (el) => el.classList.remove('hidden');
  const hide = (el) => el.classList.add('hidden');
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const setMode = (next) => {
    mode = next;
    document.querySelectorAll('.tab').forEach(b => b.classList.toggle('active', b.dataset.mode === mode));
    $('topicField').classList.toggle('hidden', mode !== 'create');
    $('draftField').classList.toggle('hidden', mode !== 'humanise');
    $('generate').textContent = mode === 'create' ? 'Research and create article' : 'Improve and humanise draft';
    $('result').style.display = 'none';
  };
  document.querySelectorAll('.tab').forEach(b => b.addEventListener('click', () => setMode(b.dataset.mode)));

  async function checkSession() {
    try {
      const r = await fetch('/api/studio/session', { cache: 'no-store' });
      const data = await r.json();
      if (!data.configured) {
        login.innerHTML = '<div class="panel"><h1>One-time setup needed.</h1><p class="intro">The private studio needs its password and AI connection configured in Railway before it can open.</p><p class="hint">Required settings: STUDIO_PASSWORD, STUDIO_SESSION_SECRET and ANTHROPIC_API_KEY.</p></div>';
        show(login); return;
      }
      if (data.authenticated) { show(workspace); show($('logout')); } else { show(login); }
    } catch { show(login); }
  }

  $('loginForm').addEventListener('submit', async (event) => {
    event.preventDefault(); hide($('loginError'));
    const button = $('loginForm').querySelector('button'); button.disabled = true; button.textContent = 'Checking...';
    try {
      const r = await fetch('/api/studio/auth', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({password:$('password').value}) });
      const data = await r.json();
      if (!r.ok) throw new Error(data.error || 'Could not sign in.');
      hide(login); show(workspace); show($('logout')); $('password').value = '';
    } catch (e) { $('loginError').textContent = e.message; show($('loginError')); }
    finally { button.disabled = false; button.textContent = 'Open studio'; }
  });

  $('logout').addEventListener('click', async () => {
    await fetch('/api/studio/logout', {method:'POST'});
    hide(workspace); hide($('logout')); show(login);
  });

  $('studioForm').addEventListener('submit', async (event) => {
    event.preventDefault(); hide($('formError')); $('result').style.display = 'none';
    const button = $('generate'); button.disabled = true;
    button.textContent = mode === 'create' ? 'Researching and creating...' : 'Reviewing and improving...';
    $('status').textContent = 'This may take a minute. Keep this page open.';
    const payload = {
      mode, brand:$('brand').value, topic:$('topic').value, draft:$('draft').value,
      primaryKeyword:$('primaryKeyword').value, secondaryKeywords:$('secondaryKeywords').value,
      audience:$('audience').value, brief:$('brief').value, wordCount:Number($('wordCount').value),
      research:$('research').checked
    };
    try {
      const response = await fetch('/api/studio/generate', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
      const data = await response.json();
      if (response.status === 401) { hide(workspace); hide($('logout')); show(login); throw new Error('Your session expired. Please sign in again.'); }
      if (!response.ok) throw new Error(data.error || 'The article could not be generated.');
      latest = data;
      render(data);
      $('result').style.display = 'block';
      $('result').scrollIntoView({behavior:'smooth',block:'start'});
    } catch (e) { $('formError').textContent = e.message; show($('formError')); }
    finally { button.disabled = false; button.textContent = mode === 'create' ? 'Research and create article' : 'Improve and humanise draft'; $('status').textContent = ''; }
  });

  function render(data) {
    const report = data.editorial_report || {}, scores = report.scores || {};
    $('resultTitle').textContent = data.title || 'Your article';
    $('score').textContent = 'Editorial quality: ' + (report.overall_score ?? 'Not scored') + '/100';
    $('accuracy').textContent = scores.accuracy_and_evidence ?? '—';
    $('usefulness').textContent = scores.reader_usefulness ?? '—';
    $('originality').textContent = scores.originality_and_depth ?? '—';
    $('voice').textContent = scores.voice_and_readability ?? '—';
    $('seoTitle').value = data.seo_title || '';
    $('metaDescription').value = data.meta_description || '';
    $('slug').value = data.suggested_slug || '';
    $('resultKeyword').value = data.primary_keyword || '';
    $('article').textContent = data.article_markdown || '';
    $('strengths').innerHTML = (report.strengths || []).map(x => '<li>'+escapeHtml(x)+'</li>').join('') || '<li>No strengths supplied.</li>';
    $('issues').innerHTML = (report.issues_to_review || []).map(x => '<li><b>'+escapeHtml(x.severity)+':</b> '+escapeHtml(x.issue)+' '+escapeHtml(x.recommendation)+'</li>').join('') || '<li>No outstanding issues reported.</li>';
    $('sources').innerHTML = (data.sources || []).map(x => '<li><a href="'+escapeHtml(x.url)+'" target="_blank" rel="noopener noreferrer">'+escapeHtml(x.title || x.url)+'</a> '+escapeHtml(x.publisher || '')+'</li>').join('') || '<li>No sources were returned. Check research notes before publication.</li>';
    const notes = [...(report.review_notes || [])];
    if (report.clinical_or_subject_expert_review_required) notes.unshift('Expert review is required before publication.');
    $('reviewNote').textContent = notes.join(' ');
  }

  $('copy').addEventListener('click', async () => {
    if (!latest) return;
    await navigator.clipboard.writeText(latest.article_markdown || '');
    $('copy').textContent = 'Copied'; setTimeout(() => $('copy').textContent = 'Copy article', 1500);
  });
  $('download').addEventListener('click', () => {
    if (!latest) return;
    const blob = new Blob([latest.article_markdown || ''], {type:'text/markdown;charset=utf-8'});
    const url = URL.createObjectURL(blob), a = document.createElement('a');
    a.href = url; a.download = (latest.suggested_slug || 'article') + '.md'; a.click(); URL.revokeObjectURL(url);
  });
  checkSession();
})();
</script>
</body>
</html>
