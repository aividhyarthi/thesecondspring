---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'The Second Spring – Your Perimenopause Companion', description = 'A compassionate companion for women navigating perimenopause.' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index, follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="navbar">
      <div class="container navbar-inner">
        <a href="/" class="brand">
          <span class="brand-the">The</span>
          <span class="brand-second">Second</span>
          <span class="brand-spring">Spring</span>
        </a>
        <ul class="nav-links" id="nav-links">
          <li><a href="/" class:list={[{ active: currentPath === '/' }]}>Home</a></li>
          <li><a href="/chat" class:list={[{ active: currentPath.startsWith('/chat') }]}>Chat</a></li>
        </ul>
        <div class="navbar-right">
          <a href="/chat" class="btn btn-primary navbar-cta">Start Chatting</a>
          <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
        </div>
      </div>
    </nav>
    <main><slot /></main>
    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="footer-brand"><span style="color:#7FB89A;">The</span><span style="color:#fff;"> Second </span><span style="color:#D4845A;">Spring</span></div>
            <p class="footer-tagline">A private, compassionate companion for women navigating perimenopause. Information and support — not medical advice.</p>
            <div class="footer-disclaimer">This service provides general health information only. It is not a substitute for professional medical advice. Always consult your GP.</div>
          </div>
          <div>
            <h4>Navigate</h4>
            <ul><li><a href="/">Home</a></li><li><a href="/chat">Chat with us</a></li></ul>
          </div>
          <div>
            <h4>Legal</h4>
            <ul><li><a href="/privacy">Privacy Policy</a></li><li><a href="/terms">Terms</a></li><li><a href="/disclaimer">Medical Disclaimer</a></li></ul>
          </div>
        </div>
        <div class="footer-bottom"><p>&copy; {new Date().getFullYear()} The Second Spring. General health information only — not medical advice.</p></div>
      </div>
    </footer>
    <script>
      const toggle = document.getElementById('mobile-toggle');
      const links = document.getElementById('nav-links');
      toggle?.addEventListener('click', () => links?.classList.toggle('open'));
    </script>
  </body>
</html>
<style is:global>
  :root {
    --green: #3D7A5F; --green-dark: #2A5C45; --green-light: #EEF7F2;
    --peach: #D4845A; --peach-dark: #B8693F; --peach-light: #FDF2EC;
    --cream: #FAFDF8; --cream-mid: #F2F9F4;
    --border: #C8E0D2; --border-light: #E0F0E8;
    --text: #1A2E22; --text-secondary: #3A5444; --text-muted: #6B8A76;
    --radius-sm: 8px; --radius: 14px; --radius-lg: 22px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
  body { font-family: 'Inter', system-ui, sans-serif; background: var(--cream); color: var(--text); line-height: 1.7; font-size: 16px; min-height: 100vh; }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--green); text-decoration: none; transition: color .2s; }
  .container { max-width: 1120px; margin: 0 auto; padding: 0 1.5rem; }
  .btn { display: inline-flex; align-items: center; gap: .5rem; padding: .72rem 1.65rem; border-radius: var(--radius-sm); font-weight: 600; font-size: .93rem; transition: all .2s; cursor: pointer; border: 2px solid transparent; text-decoration: none; white-space: nowrap; }
  .btn-primary { background: var(--green); color: #fff; border-color: var(--green); }
  .btn-primary:hover { background: var(--green-dark); border-color: var(--green-dark); color: #fff; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(61,122,95,.28); }
  .btn-outline-white { background: transparent; color: #fff; border-color: rgba(255,255,255,.55); }
  .btn-outline-white:hover { background: rgba(255,255,255,.12); color: #fff; }
  .btn-lg { padding: .95rem 2.25rem; font-size: 1.05rem; }
  .navbar { position: sticky; top: 0; z-index: 100; background: rgba(250,253,248,.96); border-bottom: 1.5px solid var(--border); backdrop-filter: blur(12px); }
  .navbar-inner { display: flex; align-items: center; height: 66px; gap: 1.5rem; }
  .brand { display: flex; align-items: baseline; gap: .22rem; text-decoration: none; flex-shrink: 0; }
  .brand-the { font-size: .82rem; font-weight: 500; color: var(--text-muted); font-style: italic; }
  .brand-second { font-size: 1.22rem; font-weight: 800; color: var(--green-dark); }
  .brand-spring { font-size: 1.22rem; font-weight: 800; color: var(--peach); }
  .nav-links { display: flex; align-items: center; gap: .15rem; list-style: none; flex: 1; }
  .nav-links a { color: var(--text-secondary); font-size: .92rem; font-weight: 500; padding: .4rem .85rem; border-radius: 8px; transition: all .18s; }
  .nav-links a:hover, .nav-links a.active { background: var(--green-light); color: var(--green-dark); }
  .navbar-right { display: flex; align-items: center; gap: .75rem; margin-left: auto; }
  .mobile-toggle { display: none; background: none; border: none; cursor: pointer; padding: .35rem; color: var(--green-dark); }
  .footer { background: #1A2E22; color: #8BAF98; padding: 3.5rem 0 2rem; margin-top: 5rem; }
  .footer-grid { display: grid; grid-template-columns: 1.8fr 1fr 1fr; gap: 2.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid #253D2E; }
  .footer-brand { font-size: 1.35rem; font-weight: 800; margin-bottom: .75rem; }
  .footer-tagline { font-size: .9rem; line-height: 1.65; margin-bottom: 1.25rem; }
  .footer-disclaimer { font-size: .78rem; line-height: 1.65; color: #5A7A68; padding: 1rem; background: #253D2E; border-radius: 8px; border-left: 3px solid var(--green); }
  .footer h4 { color: #C8E0D2; font-size: .82rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; margin-bottom: .85rem; }
  .footer ul { list-style: none; }
  .footer ul li { margin-bottom: .45rem; }
  .footer ul li a { color: #8BAF98; font-size: .88rem; }
  .footer ul li a:hover { color: #C8E0D2; }
  .footer-bottom { padding-top: 1.5rem; font-size: .82rem; color: #5A7A68; text-align: center; }
  @media (max-width: 700px) {
    .nav-links { display: none; flex-direction: column; position: absolute; top: 66px; left: 0; right: 0; background: var(--cream); padding: .75rem 1.5rem 1.25rem; border-bottom: 1.5px solid var(--border); z-index: 99; align-items: flex-start; }
    .nav-links.open { display: flex; }
    .mobile-toggle { display: block; }
    .navbar-cta { display: none; }
    .navbar-inner { position: relative; }
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
